DB_HOST=localhost
DB_PORT=5432
DB_USER=lab
DB_NAME=lab
PORT=8000
EPICS_GATEWAY_ADDR=http://epics-gateway:5070
INFLUXDB_ADDR=http://influxdb:8086
INFLUXDB_ORG=lab-org
INFLUXDB_BUCKET=lab-bucket
INFLUXDB_MEASUREMENTS=pressure,vacuum,control,temperature,pump
DEEPSEEK_API_KEY=
# Optional; omit until the Keysight 33210A LAN address is confirmed (host:port).
KEYSIGHT_33210A_ADDR=

# --- System update ---
# Engine: go=Step-driven pipeline in a detached runner container (default, recommended);
#         shell=same runner container but running .hermes/update.sh as entrypoint (fallback).
# .hermes/update.sh can also be run manually on the host (repo must be writable there).
UPDATE_ENGINE=go
# Space-separated flags forwarded to the update engine (--force / --dry-run / --no-rollback). Empty by default.
UPDATE_FLAGS=
# Runner runs as UPDATE_RUN_UID:GID inside the container; docker.sock access needs UPDATE_DOCKER_GID.
# UPDATE_DOCKER_GID must match the host docker.sock group: run `stat -c %g /var/run/docker.sock` on the
# host and set the actual value here; the default 993 is only a guess.
UPDATE_RUN_UID=1000
UPDATE_RUN_GID=1000
UPDATE_DOCKER_GID=993
# Host-absolute directory for DB backups (mounted into the runner container).
UPDATE_BACKUP_DIR=/opt/hiaf-lab-system/.hermes/backups
# Host-absolute directory for update session logs (shared by server and runner at the same path).
UPDATE_LOG_DIR=/opt/hiaf-lab-system/.hermes/updates
# ntfy publish URL reachable from the update runner container (runs with --network host,
# i.e. the host network stack): ntfy publishes 127.0.0.1:8085 on the host, so localhost works.
# The compose-internal name ntfy:80 is NOT resolvable from the host-network runner.
UPDATE_NTFY_URL=http://localhost:8085/lab-system
# Optional: image the update runner container uses (default: the server image, which ships the lab-update binary).
UPDATE_RUNNER_IMAGE=
# Optional: docker compose project name the runner operates on (default: current compose project).
UPDATE_PROJECT=
# Optional: host dir holding .gitconfig/.ssh for the runner's git fetch (read-only passthrough). Leave empty to skip.
UPDATE_GIT_HOME=
