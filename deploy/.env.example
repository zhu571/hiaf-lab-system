DB_HOST=localhost
DB_PORT=5432
DB_USER=lab
DB_NAME=lab
PORT=8000
EPICS_GATEWAY_ADDR=http://epics-gateway:5070
INFLUXDB_ADDR=http://influxdb:8086
INFLUXDB_ORG=lab-org
INFLUXDB_BUCKET=lab-bucket
INFLUXDB_MEASUREMENTS=pressure,vacuum,control,temperature,pump
# InfluxDB 初始化 admin token（influxdb 容器首启与 Grafana provisioning 数据源共用）
INFLUX_TOKEN=
DEEPSEEK_API_KEY=
# py-agent 模型接入（默认值即历史硬编码行为）。租约由 worker 周期续约维持（R8），
# 不再要求 LLM 超时 < AGENT_LEASE_SECONDS（默认 300）；启动时校验
# 「续约间隔(≤90s) + 单次请求最坏耗时(3×REQUEST_TIMEOUT_SECONDS+3) < AGENT_LEASE_SECONDS」。
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 备选模型：仅配置化，暂不自动降级（空 = 未配置）
DEEPSEEK_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=180
# Optional; omit until the Keysight 33210A LAN address is confirmed (host:port).
KEYSIGHT_33210A_ADDR=

# --- System update ---
# Engine: go=Step-driven pipeline in a detached runner container (default, recommended);
#         shell=same runner container but running .hermes/update.sh as entrypoint (fallback).
# .hermes/update.sh can also be run manually on the host (repo must be writable there).
UPDATE_ENGINE=go
# Space-separated flags forwarded to the update engine (--force / --dry-run / --no-rollback). Empty by default.
UPDATE_FLAGS=
# Host-absolute repo path. All compose mounts and REPO_ROOT env derive from it.
# gascell 部署示例：仓库在 /home/gascell/hiaf-lab-system（不是 /opt）。
REPO_ROOT=/home/gascell/hiaf-lab-system
# 更新分支（默认 main；pull/回滚/behind 双引擎统一读它）
UPDATE_BRANCH=main
# 更新阶段看门狗（server 看门狗与 runner 流水线读同一值，调整时两层同步生效）
UPDATE_UPDATE_TIMEOUT=30m
# shell 引擎入口脚本（相对仓库；空 = .hermes/update.sh）
UPDATE_SCRIPT_PATH=
# Runner runs as UPDATE_RUN_UID:GID inside the container; docker.sock access needs UPDATE_DOCKER_GID.
# UPDATE_DOCKER_GID must match the host docker.sock group: run `stat -c %g /var/run/docker.sock` on the
# host and set the actual value here; the default 993 is only a guess.
# 提示：宿主机要手工跑 .hermes/update.sh 时，执行用户应与 UPDATE_RUN_UID 一致
#（或同组），否则仓库共享锁目录（.hermes/updates）与备份目录可能互相不可写。
UPDATE_RUN_UID=1000
UPDATE_RUN_GID=1000
UPDATE_DOCKER_GID=993
# Host-absolute directory for DB backups (mounted into the runner container).
# 默认随 REPO_ROOT；显式设置时必须是宿主机绝对路径。
UPDATE_BACKUP_DIR=/home/gascell/hiaf-lab-system/.hermes/backups
# Host-absolute directory for update session logs (shared by server and runner at the same path).
UPDATE_LOG_DIR=/home/gascell/hiaf-lab-system/.hermes/updates
# ntfy publish URL reachable from the update runner container (runs with --network host,
# i.e. the host network stack): ntfy publishes 127.0.0.1:8085 on the host, so localhost works.
# The compose-internal name ntfy:80 is NOT resolvable from the host-network runner.
UPDATE_NTFY_URL=http://localhost:8085/lab-system
# Optional: image the update runner container uses (default: the server image, which ships the lab-update binary).
UPDATE_RUNNER_IMAGE=
# Optional: docker compose project name the runner operates on (default: current compose project).
UPDATE_PROJECT=
# git 凭据家目录（专用 deploy-key 目录，不挂用户家目录）。默认 <REPO_ROOT>/.hermes/runner-home。
# gascell 首次配置（详见 .hermes/runner-home/README.md）：
#   1) ssh-keygen -t ed25519 -f $REPO_ROOT/.hermes/runner-home/.ssh/id_ed25519 -N "" -C "gascell-lab-deploy"
#   2) 公钥加入 GitHub 仓库 Settings → Deploy keys（只读即可）
#   3) ssh-keyscan -t ed25519,ecdsa,rsa github.com >> $REPO_ROOT/.hermes/runner-home/.ssh/known_hosts
#   4) chown -R 1000:1000 $REPO_ROOT/.hermes/runner-home && chmod 600 .../id_ed25519
UPDATE_GIT_HOME=/home/gascell/hiaf-lab-system/.hermes/runner-home

# --- Todolist ---
# Enable the todos scheduler (08:30 rollover / 09:00 ntfy push / 23:00 generate / 23:30 cleanup).
# Default true; set to "false" to disable (e.g. during maintenance).
TODOS_SCHEDULER_ENABLED=true
# 周报（AI-1）定时调度：每周日 20:00 生成；WEEKLY_SUMMARY_AUTHOR_ID 填一个 maintainer/admin 用户 UUID，
# 留空则定时跳过（手动 `labctl weekly generate` 不受影响）。
WEEKLY_SCHEDULER_ENABLED=true
WEEKLY_SUMMARY_AUTHOR_ID=
# Publicly reachable ntfy base URL used to build per-user subscribe URLs shown in TodoView.
# In the lab this is the frp/VPS HTTPS address; the compose-internal ntfy:80 is NOT reachable
# from users' phones.
NTFY_PUBLIC_URL=https://ntfy.域名

# --- Grafana ---
# Grafana 绑定地址（默认 127.0.0.1，全接口不暴露）；外网访问走 frp/VPS 反代，
# 参照 ntfy 的 10.144.144.12:8087 模式。admin 密码见 deploy/secrets/grafana_admin_password.txt。
GRAFANA_BIND_ADDR=127.0.0.1

# --- InfluxDB ---
# 8086 端口绑定地址（默认 127.0.0.1，与 Grafana/Prometheus 同模式）：该服务持有
# 全库读写 token。server/ioc/Grafana 走 compose 网络内的 influxdb:8086，
# 不依赖宿主端口；确需外部访问 Influx UI 时才放宽并配合反代。
INFLUXDB_BIND_ADDR=127.0.0.1

# --- CORS ---
# 浏览器跨域白名单（逗号分隔）。生产同源（前端经 server go:embed 同端口托管）无需配置；
# 独立域名/端口前端在 .env 追加。默认 vite dev 两个回环变体。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- 公网开放安全加固（方案 2026-08-10_group-access）---
# 统一 HTTPS 入口时启用（COOKIE_SECURE=true）；本期不启用双协议（S3）
COOKIE_SECURE=true
# 开放注册开关：默认 false；true 时自助注册仍必须使用一次性邀请码
ALLOW_REGISTER=false
# 来源门共享秘密：Caddy 与后端两端一致，≥32 字符随机（S4）
LAB_PROXY_SHARED_SECRET=
# 来源门开关：true 强制公网写路径白名单（与代码安全默认一致，compose 缺省亦为 true）；
# false 完全放行（回滚开关，S4）
SOURCE_GATE_ENABLED=true
# 登录 IP 级滑动窗口限流：20 次 / 15 分钟 / IP，跨用户名聚合（置 0 关闭，S1）
LOGIN_RATE_LIMIT_IP_MAX=20
LOGIN_RATE_LIMIT_IP_WINDOW=15m
