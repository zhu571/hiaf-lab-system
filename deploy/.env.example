KEYSIGHT_33210A_ADDR=

# System update engine switch: go=new Step-driven pipeline; shell=legacy .hermes/update.sh (default).
UPDATE_ENGINE=shell
# Space-separated flags forwarded to the update engine (--force / --dry-run / --no-rollback). Empty by default.
UPDATE_FLAGS=
