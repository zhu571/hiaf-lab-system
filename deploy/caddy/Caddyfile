# hiaf-lab-system 公网反代配置（2026-08-10 方案 v4，§4.1）
# 部署前提：VPS 已装 Caddy 且已加入 EasyTier 虚拟网（10.144.144.100 → gascell 10.144.144.12）
# 部署步骤（域名购买后）：
#   1. 将下方两处 域名 替换为实际域名（实际：hiaf-gascell.site）
#   2. DNS A 记录 → VPS 公网 IP 134.175.232.67
#   3. 环境变量 LAB_PROXY_SHARED_SECRET（≥32 字符随机）在 Caddy systemd/容器 与 gascell 两端一致
#   4. caddy validate --config Caddyfile 验证后启动；旧配置保留 Caddyfile.bak
#
# 安全要点（source-gate 状态机，go-server/middleware/source_gate.go）：
#   - header_up -X-Forwarded-For 必须【先删后设】：Caddy 默认 append，攻击者伪造首值会存活
#   - X-Lab-Proxy 共享秘密头：peer==Caddy 且秘密匹配 → 公网入口（信任覆写后 XFF）
#   - flush_interval -1 关缓冲（SSE 实时，后端已有 X-Accel-Buffering: no）

# lab 主站
https://lab.hiaf-gascell.site {
    encode gzip zstd
    @metrics path /metrics
    respond @metrics 404                          # D14：公网不暴露 /metrics
    request_body max_size 32MB
    reverse_proxy 10.144.144.12:8000 {
        header_up -X-Forwarded-For                            # ① 先删（防伪造首值存活）
        header_up X-Forwarded-For {http.request.remote.host}  # ② 覆写真实 peer（唯一值）
        header_up X-Lab-Proxy {$LAB_PROXY_SHARED_SECRET}      # ③ 共享秘密头（D9 校验）
        flush_interval -1                                     # ④ 关缓冲（SSE 实时）
    }
}

# ntfy 通知（D10）
https://ntfy.hiaf-gascell.site {
    reverse_proxy 10.144.144.12:8087 {
        flush_interval -1
    }
}
