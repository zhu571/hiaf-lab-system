{
  "id": null,
  "uid": "lab-system-overview",
  "title": "实验室总览",
  "tags": ["lab", "sensors"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "InfluxDB Bucket",
        "type": "constant",
        "query": "lab-bucket",
        "current": {
          "text": "lab-bucket",
          "value": "lab-bucket"
        },
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "uid": "panel-pressure-latest",
      "type": "stat",
      "title": "最新压力",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flux"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"pressure\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bar"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "uid": "panel-vacuum-latest",
      "type": "stat",
      "title": "最新真空度",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flux"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"vacuum\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mbar"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "uid": "panel-pressure-trend",
      "type": "timeseries",
      "title": "压力 / 真空趋势（近 1 小时）",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-flux"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-flux"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"pressure\" or r._measurement == \"vacuum\")\n  |> filter(fn: (r) => r._field == \"value\")\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
